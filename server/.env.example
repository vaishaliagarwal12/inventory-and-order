# Express API Server Port
PORT=5000

# Environment Mode (development / production / test)
NODE_ENV=development

# CORS Allowed Origins (Comma-separated for production e.g. https://your-frontend.vercel.app)
CORS_ORIGIN=*

# Database Connection (DATABASE_URL takes precedence if set, e.g. on Render/Neon/Railway/Supabase)
# DATABASE_URL=postgres://user:password@ep-cool-db.us-east-1.aws.neon.tech/inventory_db?sslmode=require

# Individual Database Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password

# Authentication & JWT Security Settings
JWT_SECRET=your_strong_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1d

# Business & Threshold Settings
LOW_STOCK_THRESHOLD=10
